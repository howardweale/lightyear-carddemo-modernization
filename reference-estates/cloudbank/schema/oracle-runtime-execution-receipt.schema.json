{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.local/schema/cloudbank-oracle-runtime-execution-receipt.schema.json",
  "title": "Signed CloudBank Oracle runtime execution receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "release",
    "source",
    "oracle_runtime_plan_sha256",
    "build_receipt_sha256",
    "toolchain",
    "oracle_image",
    "oracle_image_id_sha256",
    "command",
    "test_results",
    "status",
    "security",
    "source_build_observed",
    "oracle_runtime_observed",
    "cloudbank_source_baseline_complete",
    "customer_service_runtime_observed",
    "production_data_observed",
    "postgresql_mapping_complete",
    "target_equivalent",
    "migration_complete",
    "production_ready",
    "content_sha256",
    "signature"
  ],
  "properties": {
    "receipt_type": {"const": "lightyear-cloudbank-oracle-runtime-execution-receipt"},
    "release": {"const": "0.54.0"},
    "oracle_image": {"const": "gvenzl/oracle-free:23.26.1-slim-faststart"},
    "status": {"const": "passed"},
    "source_build_observed": {"const": true},
    "oracle_runtime_observed": {"const": true},
    "cloudbank_source_baseline_complete": {"const": true},
    "customer_service_runtime_observed": {"const": false},
    "production_data_observed": {"const": false},
    "postgresql_mapping_complete": {"const": false},
    "target_equivalent": {"const": false},
    "migration_complete": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {
      "type": "object",
      "required": ["algorithm", "signer", "value"],
      "properties": {
        "algorithm": {"const": "hmac-sha256"},
        "signer": {"type": "string", "minLength": 1},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
