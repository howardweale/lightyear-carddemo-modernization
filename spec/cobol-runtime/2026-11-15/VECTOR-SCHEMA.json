{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slice 1A closed codec vector file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "author",
    "source_basis",
    "profile_sha256",
    "vectors"
  ],
  "properties": {
    "schema": {
      "const": "cobol-codec-vectors/1"
    },
    "author": {
      "type": "string",
      "enum": [
        "Claude",
        "Codex"
      ]
    },
    "source_basis": {
      "const": "IBM Enterprise COBOL for z/OS 6.4; public inputs only"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rule",
          "operation",
          "pic",
          "usage",
          "sign",
          "bytes",
          "coefficient",
          "scale",
          "negative_zero",
          "offset",
          "capacity",
          "reload",
          "expected",
          "reference",
          "derivation",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]{0,63}$"
          },
          "rule": {
            "type": "string",
            "enum": [
              "R01",
              "R02",
              "R03",
              "R04"
            ]
          },
          "operation": {
            "type": "string",
            "enum": [
              "decode",
              "encode",
              "numeric-class",
              "arena-alias",
              "arena-short-read"
            ]
          },
          "pic": {
            "type": "string",
            "pattern": "^[S9VP()0-9]{1,100}$"
          },
          "usage": {
            "type": "string",
            "enum": [
              "DISPLAY",
              "PACKED",
              "BINARY"
            ]
          },
          "sign": {
            "type": "string",
            "enum": [
              "UNSIGNED",
              "TRAILING",
              "LEADING",
              "TRAILING_SEPARATE",
              "LEADING_SEPARATE"
            ]
          },
          "bytes": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2}){0,32}$"
          },
          "coefficient": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]{0,17})$"
          },
          "scale": {
            "type": "integer",
            "minimum": -18,
            "maximum": 18
          },
          "negative_zero": {
            "type": "boolean"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "reload": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{2}){0,32}$"
          },
          "expected": {
            "type": "string",
            "pattern": "^(?:(?:[0-9a-f]{2}){1,32}|-?[0-9]{1,18}:-?[0-9]{1,2}:(?:true|false)|true|false|REFUSED:[a-z][a-z-]{1,40})$"
          },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "title",
              "url",
              "locator"
            ],
            "properties": {
              "version": {
                "const": "6.4"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              },
              "url": {
                "type": "string",
                "pattern": "^https://(?:www\\.ibm\\.com/docs/|publibfp\\.dhe\\.ibm\\.com/epubs/)[^\\s]+$"
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              }
            }
          },
          "derivation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
