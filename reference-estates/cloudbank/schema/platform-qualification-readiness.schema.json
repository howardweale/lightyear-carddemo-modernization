{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schemas/cloudbank/platform-qualification-readiness.schema.json",
  "title": "CloudBank MS67 platform qualification readiness receipt",
  "type": "object",
  "required": [
    "schema_version", "receipt_type", "release", "bindings", "acceptance_contract_sha256",
    "gate_status", "non_production_platform_qualified", "migration_complete", "production_deployed",
    "production_ready", "content_sha256"
  ],
  "properties": {
    "receipt_type": {"const": "lightyear-cloudbank-non-production-platform-qualification-readiness"},
    "release": {"const": "0.67.0"},
    "gate_status": {"const": "ready-for-signed-ms65-ms66-and-authorized-real-platform-observation"},
    "non_production_platform_qualified": {"const": false},
    "migration_complete": {"const": false},
    "production_deployed": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
