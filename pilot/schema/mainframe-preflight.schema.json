{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/mainframe-evidence-preflight-v1.json",
  "title": "LIGHTYEAR mainframe evidence preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preflight_type",
    "pilot_id",
    "intake_sha256",
    "capability_sha256",
    "appliance_sha256",
    "collection_mechanism",
    "global_requirements",
    "technologies",
    "gates",
    "ready_for_authorized_onboarding",
    "ready_for_gates_6_8",
    "mainframe_equivalent",
    "production_ready",
    "limitations",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "preflight_type": {"const": "lightyear-mainframe-evidence-preflight"},
    "pilot_id": {"type": "string"},
    "intake_sha256": {"$ref": "#/$defs/sha256"},
    "capability_sha256": {"$ref": "#/$defs/sha256"},
    "appliance_sha256": {"$ref": "#/$defs/sha256"},
    "collection_mechanism": {"type": "object"},
    "global_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "technologies": {"type": "array", "minItems": 6, "items": {"type": "object"}},
    "gates": {
      "const": {
        "6_authorized_original_execution": "blocked",
        "7_independent_comparison": "mechanism_ready",
        "8_signed_equivalence": "blocked"
      }
    },
    "ready_for_authorized_onboarding": {"const": true},
    "ready_for_gates_6_8": {"const": false},
    "mainframe_equivalent": {"const": false},
    "production_ready": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
