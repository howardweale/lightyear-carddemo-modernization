{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schema/factory/signed-work-order-1.0.json",
  "title": "LIGHTYEAR signed work-order envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "envelope_type", "issuer", "issued_at", "expires_at", "nonce", "execution_policy_sha256", "work_order", "work_order_sha256", "signature", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "envelope_type": {"const": "lightyear-signed-work-order"},
    "issuer": {"type": "object", "required": ["id", "key_id"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 1},
    "execution_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "work_order": {"type": "object"},
    "work_order_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"type": "object", "required": ["algorithm", "key_id", "value"]},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
