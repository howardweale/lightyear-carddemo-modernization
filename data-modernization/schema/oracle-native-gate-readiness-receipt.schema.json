{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.local/schema/oracle-native-gate-readiness-receipt.schema.json",
  "title": "LIGHTYEAR Oracle native execution gate readiness receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "release",
    "manifest_sha256",
    "execution_contract_sha256",
    "run_pack_index_sha256",
    "catalog_behavior_count",
    "catalog_case_count",
    "required_native_case_execution_count",
    "materialized_harness_count",
    "native_executed_case_count",
    "native_verified_behavior_count",
    "target_equivalent_behavior_count",
    "gate_status",
    "gates",
    "claim_statement",
    "native_oracle_execution_observed",
    "native_oracle_conformance",
    "target_equivalence_observed",
    "production_ready",
    "content_sha256"
  ],
  "properties": {
    "receipt_type": {"const": "lightyear-oracle-native-execution-gate-readiness"},
    "release": {"const": "0.51.0"},
    "catalog_behavior_count": {"const": 500},
    "catalog_case_count": {"const": 2000},
    "required_native_case_execution_count": {"const": 4000},
    "materialized_harness_count": {"const": 0},
    "native_executed_case_count": {"const": 0},
    "native_verified_behavior_count": {"const": 0},
    "target_equivalent_behavior_count": {"const": 0},
    "native_oracle_execution_observed": {"const": false},
    "native_oracle_conformance": {"const": false},
    "target_equivalence_observed": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
