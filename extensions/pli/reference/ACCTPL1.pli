/* Bounded mixed-language PL/I reference workload for MS #22. */
ACCTPL1: PROC OPTIONS(MAIN);
  %INCLUDE AUTHCOM;

  DCL AUTHIN  FILE RECORD INPUT;
  DCL AUTHOUT FILE RECORD OUTPUT;
  DCL RISK_SCORE DECIMAL(5,2) INIT(0);
  DCL CBACT04C ENTRY OPTIONS(COBOL);
  DCL 1 EXTERNAL_PARMS UNALIGNED,
        2 PARM_LENGTH FIXED BINARY(15) INIT(10),
        2 PARM_DATE CHAR(10) INIT('2026-08-20');

  READ FILE(AUTHIN) INTO(AUTHORIZATION_RECORD);

  EXEC SQL
    SELECT APPROVED_AMT, AUTH_FRAUD
      INTO :APPROVED_AMOUNT, :FRAUD_FLAG
      FROM CARDDEMO.AUTHFRDS
     WHERE TRANSACTION_ID = :TRANSACTION_ID;

  CALL CALC_RISK(APPROVED_AMOUNT, FRAUD_FLAG, RISK_SCORE);
  CALL CBACT04C(EXTERNAL_PARMS);
  WRITE FILE(AUTHOUT) FROM(AUTHORIZATION_RECORD);

CALC_RISK: PROC(AMOUNT, FLAG, SCORE);
  DCL AMOUNT DECIMAL(12,2);
  DCL FLAG CHAR(1);
  DCL SCORE DECIMAL(5,2);
  IF FLAG = 'Y' THEN SCORE = 100;
  ELSE SCORE = DIVIDE(AMOUNT, 100, 5, 2);
END CALC_RISK;

END ACCTPL1;
