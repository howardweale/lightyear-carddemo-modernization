@@ -0,0 +1,60 @@
+// Copyright (c) 2026, Oracle and/or its affiliates.
+// Licensed under the Universal Permissive License v 1.0.
+
+package com.example.checks.controller;
+
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Repository;
+import org.springframework.transaction.annotation.Propagation;
+import org.springframework.transaction.annotation.Transactional;
+
+@Repository
+public class MessageLedger {
+
+    private final JdbcTemplate jdbc;
+
+    public MessageLedger(JdbcTemplate jdbc) {
+        this.jdbc = jdbc;
+    }
+
+    /** Records one AQ delivery attempt; client-created duplicates are acknowledged without an effect. */
+    @Transactional(propagation = Propagation.REQUIRES_NEW)
+    public boolean claim(String messageId, String messageType, boolean redelivered) {
+        String eligibleState = redelivered
+                ? "STATE IN ('READY', 'PROCESSING')"
+                : "STATE = 'READY'";
+        int updated = jdbc.update("UPDATE MS66_CHECK_MESSAGES "
+                + "SET STATE = 'PROCESSING', ATTEMPTS = ATTEMPTS + 1, "
+                + "LAST_ERROR_CODE = NULL, UPDATED_AT = SYSTIMESTAMP "
+                + "WHERE MESSAGE_ID = ? AND MESSAGE_TYPE = ? AND " + eligibleState,
+                messageId, messageType);
+        return updated == 1;
+    }
+
+    /** Marks the one observed business effect complete. */
+    @Transactional(propagation = Propagation.REQUIRES_NEW)
+    public void complete(String messageId) {
+        int updated = jdbc.update("UPDATE MS66_CHECK_MESSAGES "
+                + "SET STATE = 'PROCESSED', LAST_ERROR_CODE = NULL, UPDATED_AT = SYSTIMESTAMP "
+                + "WHERE MESSAGE_ID = ? AND STATE = 'PROCESSING'", messageId);
+        if (updated != 1) {
+            throw new IllegalStateException("message completion transition was rejected");
+        }
+    }
+
+    /** Keeps PROCESSING durable so an AQ redelivery is observable after a crash. */
+    @Transactional(propagation = Propagation.REQUIRES_NEW)
+    public void fail(String messageId, String errorCode) {
+        jdbc.update("UPDATE MS66_CHECK_MESSAGES "
+                + "SET LAST_ERROR_CODE = ?, UPDATED_AT = SYSTIMESTAMP "
+                + "WHERE MESSAGE_ID = ? AND STATE = 'PROCESSING'",
+                bounded(errorCode), messageId);
+    }
+
+    private static String bounded(String value) {
+        if (value == null || value.isBlank()) {
+            return "DeliveryFailed";
+        }
+        return value.substring(0, Math.min(value.length(), 80));
+    }
+}
