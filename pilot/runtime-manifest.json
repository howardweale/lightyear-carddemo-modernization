{
  "schema_version": "1.0",
  "manifest_type": "lightyear-source-only-pilot-runtime",
  "release": "0.32.0",
  "required_runtime": {
    "python": ">=3.11,<4",
    "third_party_runtime_dependencies": []
  },
  "supported_platforms": ["Linux", "macOS", "Windows"],
  "installation": {
    "mode": "versioned-source-tree-launcher",
    "command": "./source-only-pilot.sh doctor",
    "requires_network": false,
    "requires_package_build_backend": false,
    "optional_console_entrypoint": "lightyear-pilot"
  },
  "repository_entrypoints": [
    "source-only-pilot.sh",
    "source-only-pilot.ps1"
  ],
  "customer_source_analysis": {
    "mode": "bounded-static-analysis",
    "customer_specific_graph": true,
    "requires_network": false,
    "retains_raw_source_in_dossier": false
  },
  "estate_assessment": {
    "mode": "deterministic-connected-component-planning",
    "business_priority_inferred": false,
    "automatic_factory_dispatch": false,
    "requires_network": false
  },
  "pilot_work_package": {
    "mode": "human-selected-graph-scoped-development-packaging",
    "draft_work_scopes_only": true,
    "automatic_factory_dispatch": false,
    "requires_network": false
  },
  "optional_paths": {
    "java_17": "compiled Spring candidate and reproducible artifact verification",
    "maven": "full Java package verification",
    "docker": "live target-database development proofs"
  },
  "mainframe_equivalent": false,
  "production_ready": false,
  "content_sha256": "e48b52660a28f27636efd67924adfcb56dd14791f584bdf773a74b32c227a2c4"
}
