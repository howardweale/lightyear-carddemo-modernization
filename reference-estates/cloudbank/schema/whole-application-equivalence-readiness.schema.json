{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schemas/cloudbank/whole-application-equivalence-readiness.schema.json",
  "title": "CloudBank whole-application dual-lane readiness receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "release",
    "bindings",
    "acceptance_contract_sha256",
    "gate_status",
    "all_eight_services_observed_in_both_lanes",
    "bounded_whole_application_equivalent",
    "whole_application_equivalent",
    "exact_internal_implementation_equivalent",
    "migration_complete",
    "production_deployed",
    "production_ready",
    "content_sha256"
  ],
  "properties": {
    "receipt_type": {"const": "lightyear-cloudbank-whole-application-equivalence-readiness"},
    "release": {"const": "0.66.0"},
    "gate_status": {"const": "ready-for-signed-ms61-ms64-and-dual-lane-observations"},
    "all_eight_services_observed_in_both_lanes": {"const": false},
    "bounded_whole_application_equivalent": {"const": false},
    "whole_application_equivalent": {"const": false},
    "exact_internal_implementation_equivalent": {"const": false},
    "migration_complete": {"const": false},
    "production_deployed": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
