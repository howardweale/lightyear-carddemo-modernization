{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schema/factory/historical-model-evidence-1.0.json",
  "title": "LIGHTYEAR historical live-model evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_type", "evidence_id", "evaluation_id",
    "evaluation_class", "workload_id", "status", "cases", "baselines_rejected",
    "autonomously_repaired", "repair_rate", "correct_no_change_rate",
    "false_acceptances", "qualification_eligible", "promotion_allowed",
    "production_ready", "mainframe_equivalent", "source", "model", "execution",
    "integrity", "compatibility", "quality_gate", "totals", "limitations",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_type": {"const": "lightyear-historical-model-evidence"},
    "evidence_id": {"type": "string", "minLength": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "evaluation_class": {"const": "public-calibration"},
    "workload_id": {"enum": ["INTCALC", "POSTTRAN", "CREASTMT", "ACCTPL1"]},
    "status": {"const": "verified"},
    "cases": {"type": "integer", "minimum": 1},
    "baselines_rejected": {"type": "integer", "minimum": 0},
    "autonomously_repaired": {"type": "integer", "minimum": 0},
    "repair_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "correct_no_change_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "false_acceptances": {"type": "integer", "minimum": 0},
    "qualification_eligible": {"const": false},
    "promotion_allowed": {"const": false},
    "production_ready": {"const": false},
    "mainframe_equivalent": {"const": false},
    "source": {"type": "object"},
    "model": {"type": "object"},
    "execution": {"type": "object"},
    "integrity": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "compatibility": {"type": "object"},
    "quality_gate": {"type": "object"},
    "totals": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
