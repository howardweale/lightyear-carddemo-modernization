{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schema/factory/model-call-evidence-1.0.json",
  "title": "LIGHTYEAR model-call evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_type", "provider", "model", "role", "store",
    "strict_schema", "request_sha256", "response_sha256", "input_tokens",
    "output_tokens", "estimated_cost_usd", "cost_estimate_available", "elapsed_ms", "call_sequence",
    "request_bytes", "response_bytes", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_type": {"const": "lightyear-model-call"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "role": {"enum": ["planner", "builder", "failure_analyst"]},
    "store": {"const": false},
    "strict_schema": {"const": true},
    "max_output_tokens": {"type": "integer", "minimum": 1},
    "attempts": {"type": "integer", "minimum": 1},
    "retry_count": {"type": "integer", "minimum": 0},
    "retries": {"type": "array", "items": {"type": "object"}},
    "rate_limits": {"type": "object", "additionalProperties": {"type": "string"}},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "estimated_cost_usd": {"type": "number", "minimum": 0},
    "cost_estimate_available": {"type": "boolean"},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "call_sequence": {"type": "integer", "minimum": 1},
    "request_bytes": {"type": "integer", "minimum": 1},
    "response_bytes": {"type": "integer", "minimum": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
