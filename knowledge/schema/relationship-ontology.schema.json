{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schemas/relationship-ontology-1.0.json",
  "additionalProperties": false,
  "properties": {
    "ontology_id": {"minLength": 1, "type": "string"},
    "relations": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "allowed_pairs": {
            "items": {
              "items": {"minLength": 1, "type": "string"},
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "minItems": 1,
            "type": "array"
          },
          "category": {"minLength": 1, "type": "string"},
          "direction": {"minLength": 1, "type": "string"},
          "evidence_policy": {"minLength": 1, "type": "string"},
          "label": {"minLength": 1, "type": "string"},
          "purpose": {"minLength": 1, "type": "string"}
        },
        "required": [
          "allowed_pairs",
          "category",
          "direction",
          "evidence_policy",
          "label",
          "purpose"
        ],
        "type": "object"
      },
      "minProperties": 1,
      "type": "object"
    },
    "schema_version": {"const": "1.0"}
  },
  "required": ["ontology_id", "relations", "schema_version"],
  "title": "LIGHTYEAR Relationship Ontology",
  "type": "object"
}
