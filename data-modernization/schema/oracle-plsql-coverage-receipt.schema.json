{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schemas/oracle-plsql-coverage-receipt.schema.json",
  "title": "LIGHTYEAR Oracle PL/SQL cumulative coverage receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "release",
    "base_catalog_sha256",
    "prior_core_corpus_sha256",
    "plsql_corpus_sha256",
    "plsql_behavior_verified_count",
    "plsql_case_verified_count",
    "catalog_behavior_verified_count",
    "catalog_case_verified_count",
    "bounded_model_verified_behavior_count",
    "bounded_model_evidence_record_count",
    "remaining_catalog_case_count",
    "native_oracle_verified_behavior_count",
    "target_equivalent_behavior_count",
    "status",
    "native_oracle_execution_observed",
    "native_oracle_conformance",
    "production_ready",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_type": {"const": "lightyear-oracle-plsql-coverage"},
    "release": {"const": "0.50.2"},
    "plsql_behavior_verified_count": {"const": 80},
    "plsql_case_verified_count": {"const": 320},
    "catalog_behavior_verified_count": {"const": 310},
    "catalog_case_verified_count": {"const": 1240},
    "bounded_model_verified_behavior_count": {"const": 312},
    "bounded_model_evidence_record_count": {"const": 1264},
    "remaining_catalog_case_count": {"const": 760},
    "native_oracle_verified_behavior_count": {"const": 0},
    "target_equivalent_behavior_count": {"const": 0},
    "status": {"const": "passed-bounded-plsql"},
    "native_oracle_execution_observed": {"const": false},
    "native_oracle_conformance": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
