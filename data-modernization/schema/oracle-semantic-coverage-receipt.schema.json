{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schemas/oracle-semantic-coverage-receipt.schema.json",
  "title": "LIGHTYEAR Oracle semantic coverage receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "catalog_sha256",
    "domain_count",
    "behavior_contract_count",
    "case_specification_count",
    "bounded_model_verified_behavior_count",
    "bounded_model_executed_case_count",
    "native_oracle_verified_behavior_count",
    "native_oracle_executed_case_count",
    "target_equivalent_behavior_count",
    "status",
    "claim_statement",
    "case_implementation_complete",
    "native_oracle_execution_observed",
    "native_oracle_conformance",
    "migration_complete",
    "production_ready",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_type": {"const": "lightyear-oracle-semantic-coverage"},
    "domain_count": {"const": 10},
    "behavior_contract_count": {"const": 500},
    "case_specification_count": {"const": 2000},
    "bounded_model_verified_behavior_count": {"const": 8},
    "bounded_model_executed_case_count": {"const": 24},
    "native_oracle_verified_behavior_count": {"const": 0},
    "native_oracle_executed_case_count": {"const": 0},
    "target_equivalent_behavior_count": {"const": 0},
    "status": {"const": "catalogued-program-foundation"},
    "case_implementation_complete": {"const": false},
    "native_oracle_execution_observed": {"const": false},
    "native_oracle_conformance": {"const": false},
    "migration_complete": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
