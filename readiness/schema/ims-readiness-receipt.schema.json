{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorydark.ai/schemas/ims-readiness-receipt-1.0.json",
  "title": "FactoryDark IMS Readiness Receipt",
  "type": "object",
  "required": ["schema_version", "receipt_type", "workload_id", "comparison_sha256", "checks", "development_ready", "mainframe_equivalent", "status", "unresolved_gaps", "signature", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_type": {"const": "factorydark-ims-readiness"},
    "workload_id": {"const": "workload:carddemo-ims-expired-authorization-purge"},
    "comparison_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {"type": "object"},
    "development_ready": {"type": "boolean"},
    "mainframe_equivalent": {"type": "boolean"},
    "status": {"enum": ["passed", "blocked"]},
    "unresolved_gaps": {"type": "array", "items": {"type": "string"}},
    "signature": {"type": ["object", "null"]},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
