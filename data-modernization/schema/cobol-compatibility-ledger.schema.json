{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/cobol-compatibility-ledger.schema.json",
  "title": "LIGHTYEAR COBOL compatibility ledger",
  "type": "object",
  "required": ["schema_version", "ledger_type", "graph_content_sha256", "classifications", "entries", "statistics", "qualification_blocked", "mainframe_equivalent", "production_ready", "content_sha256"],
  "properties": {
    "ledger_type": {"const": "lightyear-cobol-compatibility-ledger"},
    "classifications": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true},
    "entries": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["item_id", "scope", "source_semantics", "target_semantics", "classification", "rationale", "evidence_required", "decision"]}},
    "qualification_blocked": {"const": true},
    "mainframe_equivalent": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
