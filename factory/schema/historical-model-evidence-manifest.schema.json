{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schema/factory/historical-model-evidence-manifest-1.0.json",
  "title": "LIGHTYEAR historical model evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_type", "evidence_id", "source_archive_sha256",
    "evaluation_receipt_sha256", "expected", "current_policy",
    "qualification_eligible", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_type": {"const": "lightyear-historical-model-evidence-manifest"},
    "evidence_id": {"type": "string", "minLength": 1},
    "source_archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluation_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_id", "evaluation_class", "workload_id", "provider", "model",
        "cases", "model_calls", "input_tokens", "output_tokens",
        "estimated_cost_usd", "cost_estimate_available"
      ],
      "properties": {
        "evaluation_id": {"type": "string", "minLength": 1},
        "evaluation_class": {"const": "public-calibration"},
        "workload_id": {"enum": ["INTCALC", "POSTTRAN", "CREASTMT", "ACCTPL1"]},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "cases": {"type": "integer", "minimum": 1},
        "model_calls": {"type": "integer", "minimum": 1},
        "input_tokens": {"type": "integer", "minimum": 1},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_cost_usd": {"type": "number", "minimum": 0},
        "cost_estimate_available": {"const": true}
      }
    },
    "current_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_average_input_tokens", "minimum_runs_per_workload", "required_workloads"
      ],
      "properties": {
        "maximum_average_input_tokens": {"type": "integer", "minimum": 1},
        "minimum_runs_per_workload": {"type": "integer", "minimum": 2},
        "required_workloads": {"const": 4}
      }
    },
    "qualification_eligible": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
