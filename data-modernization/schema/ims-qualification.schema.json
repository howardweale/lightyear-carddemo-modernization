{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/ims-qualification.schema.json",
  "title": "LIGHTYEAR IMS qualification",
  "type": "object",
  "required": ["schema_version", "qualification_type", "qualification_id", "bindings", "inventory", "qualification_gates", "required_native_evidence", "qualification_mechanism_ready", "development_ready", "native_ims_qualified", "ims_tm_qualified", "fast_path_qualified", "dbrc_recovery_equivalent", "restart_equivalent", "ims_runtime_equivalent", "mainframe_equivalent", "production_ready", "claim_unlocked", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "qualification_type": {"const": "lightyear-ims-qualification"},
    "qualification_id": {"const": "carddemo-ims-v0.40"},
    "bindings": {"type": "object"},
    "inventory": {"type": "object"},
    "qualification_gates": {"type": "array", "minItems": 11, "maxItems": 11},
    "required_native_evidence": {"type": "array", "minItems": 8},
    "qualification_mechanism_ready": {"const": true},
    "development_ready": {"const": true},
    "native_ims_qualified": {"const": false},
    "ims_tm_qualified": {"const": false},
    "fast_path_qualified": {"const": false},
    "dbrc_recovery_equivalent": {"const": false},
    "restart_equivalent": {"const": false},
    "ims_runtime_equivalent": {"const": false},
    "mainframe_equivalent": {"const": false},
    "production_ready": {"const": false},
    "claim_unlocked": {"type": "string"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
