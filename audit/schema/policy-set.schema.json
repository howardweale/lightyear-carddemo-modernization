{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/policy-set.schema.json",
  "title": "LIGHTYEAR audit policy set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "policies"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "override_allowed"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 200},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "override_allowed": {"type": "boolean"}
        }
      }
    }
  }
}
