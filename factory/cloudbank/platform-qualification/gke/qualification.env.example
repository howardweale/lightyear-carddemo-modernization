export CERT_MANAGER_CHART_VERSION="replace-with-approved-exact-version"
export INGRESS_NGINX_CHART_VERSION="replace-with-approved-exact-version"
# Must include an immutable digest; tags are refused.
export JAVA_BASE_IMAGE="europe-west2-docker.pkg.dev/PROJECT/approved-images/java21@sha256:replace"
