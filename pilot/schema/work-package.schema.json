{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/pilot-work-package-v1.json",
  "title": "LIGHTYEAR pilot work package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "work_package_type", "package_id", "selection_sha256",
    "assessment_sha256", "analysis_graph_sha256", "dossier_sha256", "policy_sha256",
    "selected_cluster_id", "source_scope", "cells", "planning_waves", "portfolio_policy",
    "work_package_ready", "factory_dispatch_allowed", "authorized_execution_observed",
    "mainframe_equivalent", "production_ready", "claim_unlocked", "limitations",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "work_package_type": {"const": "lightyear-pilot-work-package"},
    "package_id": {"type": "string", "minLength": 1},
    "selection_sha256": {"$ref": "#/$defs/sha256"},
    "assessment_sha256": {"$ref": "#/$defs/sha256"},
    "analysis_graph_sha256": {"$ref": "#/$defs/sha256"},
    "dossier_sha256": {"$ref": "#/$defs/sha256"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "selected_cluster_id": {"type": "string", "minLength": 1},
    "source_scope": {"type": "object"},
    "cells": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "planning_waves": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object"}},
    "portfolio_policy": {"type": "object"},
    "work_package_ready": {"const": true},
    "factory_dispatch_allowed": {"const": false},
    "authorized_execution_observed": {"const": false},
    "mainframe_equivalent": {"const": false},
    "production_ready": {"const": false},
    "claim_unlocked": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
