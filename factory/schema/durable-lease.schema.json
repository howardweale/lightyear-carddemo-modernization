{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schema/durable-lease.schema.json",
  "title": "LIGHTYEAR durable work lease",
  "type": "object",
  "required": ["schema_version", "lease_type", "item_id", "run_id", "work_order_id", "work_order_sha256", "wave", "attempt", "max_attempts", "worker_id", "lease_token", "lease_expires_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "lease_type": {"const": "lightyear-durable-work-lease"},
    "item_id": {"type": "string"},
    "run_id": {"type": "string"},
    "work_order_id": {"type": "string"},
    "work_order_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wave": {"type": "integer", "minimum": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "max_attempts": {"type": "integer", "minimum": 1},
    "worker_id": {"type": "string"},
    "lease_token": {"type": "string", "minLength": 32},
    "lease_expires_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
