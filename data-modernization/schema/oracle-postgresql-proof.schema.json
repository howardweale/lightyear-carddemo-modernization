{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/oracle-postgresql-proof.schema.json",
  "title": "LIGHTYEAR Oracle to PostgreSQL progressive proof",
  "type": "object",
  "required": ["schema_version", "proof_type", "proof_id", "source", "target", "bindings", "gates", "qualification_summary", "status", "database_migration_complete", "stored_logic_complete", "production_ready", "claim_unlocked", "content_sha256"],
  "properties": {
    "proof_type": {"const": "lightyear-oracle-postgresql-proof"},
    "gates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["gate", "claim", "status", "evidence", "limitations", "production_qualified"]
      }
    },
    "database_migration_complete": {"const": false},
    "stored_logic_complete": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
