{
  "schema_version": "1.0",
  "id": "carddemo:posttran:portfolio-cell",
  "title": "POSTTRAN modernization cell",
  "goal": "Verify the bounded POSTTRAN financial-posting policy surface.",
  "non_goals": ["Do not move money or write to a mainframe."],
  "scope": {
    "allowed_paths": ["factory/benchmarks/posttran_candidate.py"],
    "graph_node_ids": ["legacy:jcl-job:POSTTRAN", "legacy:cobol-paragraph:CBTRN02C:2000-POST-TRANSACTION"]
  },
  "acceptance": {
    "baseline_first": true,
    "max_attempts": 2,
    "gates": [{
      "id": "private-posttran-policy",
