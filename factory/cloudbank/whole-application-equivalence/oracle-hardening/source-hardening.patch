diff --git a/cloudbank-v5/account/src/test/java/com/example/accounts/services/Ms66WithdrawNoEffectCallbacksTests.java b/cloudbank-v5/account/src/test/java/com/example/accounts/services/Ms66WithdrawNoEffectCallbacksTests.java
new file mode 100644
index 00000000..b980c30c
--- /dev/null
+++ b/cloudbank-v5/account/src/test/java/com/example/accounts/services/Ms66WithdrawNoEffectCallbacksTests.java
@@ -0,0 +1,75 @@
+// Copyright (c) 2023, Oracle and/or its affiliates.
+// Licensed under the Universal Permissive License v 1.0 as shown at https://oss.oracle.com/licenses/upl/
+
+package com.example.accounts.services;
+
+import com.example.accounts.model.Account;
+import com.example.accounts.model.Journal;
+import com.example.accounts.repository.AccountRepository;
+import com.example.accounts.repository.JournalRepository;
+import com.oracle.microtx.springboot.lra.annotation.LRA;
+import com.oracle.microtx.springboot.lra.annotation.ParticipantStatus;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+import org.springframework.http.HttpStatus;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+@ExtendWith(MockitoExtension.class)
+class Ms66WithdrawNoEffectCallbacksTests {
+
+    @Mock
+    private AccountRepository accounts;
+
+    @Mock
+    private JournalRepository journals;
+
+    private WithdrawService withdraw;
+
+    @BeforeEach
+    void createService() {
+        new AccountTransferDAO(accounts, journals);
+        withdraw = new WithdrawService();
+    }
+
+    @Test
+    void clientErrorsRemainUnderInitiatorCancellationControl() throws Exception {
+        LRA boundary = WithdrawService.class
+                .getDeclaredMethod("withdraw", String.class, long.class, long.class)
+                .getAnnotation(LRA.class);
+        assertEquals(LRA.Type.MANDATORY, boundary.value());
+        assertEquals(false, boundary.end());
+        assertEquals(0, boundary.cancelOnFamily().length);
+        assertEquals(0, boundary.cancelOn().length);
+    }
+
+    @Test
+    void insufficientFundsStayJournalFreeAcrossRetriedCancellationCallbacks() throws Exception {
+        Account account = new Account("Empty", "CH", "MS66 synthetic", "cust-empty");
+        account.setAccountId(7);
+        account.setAccountBalance(5);
+        when(accounts.findByAccountId(7)).thenReturn(account);
+
+        String lra = "oracle-funds";
+        assertEquals(HttpStatus.UNPROCESSABLE_ENTITY,
+                withdraw.withdraw(lra, 7, 10).getStatusCode());
+        assertEquals(ParticipantStatus.Compensated.name(), withdraw.compensateWork(lra).getBody());
+        assertEquals(ParticipantStatus.Compensated.name(), withdraw.compensateWork(lra).getBody());
+        assertEquals(ParticipantStatus.Compensated, withdraw.status(lra, "oracle-parent").getBody());
+        assertEquals(HttpStatus.OK, withdraw.afterLRA(lra, "Cancelled").getStatusCode());
+        assertEquals(HttpStatus.OK, withdraw.afterLRA(lra, "Cancelled").getStatusCode());
+        assertEquals(ParticipantStatus.Completed.name(),
+                withdraw.completeWork("oracle-no-effect-complete").getBody());
+
+        assertEquals(5, account.getAccountBalance());
+        verify(accounts, never()).save(any(Account.class));
+        verify(journals, never()).save(any(Journal.class));
+    }
+}
