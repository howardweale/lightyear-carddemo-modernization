{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schema/enterprise-appliance-fixture-1.0.json",
  "title": "LIGHTYEAR enterprise collector deterministic response script",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_type", "collected_at", "responses", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "fixture_type": {"const": "lightyear-enterprise-appliance-script"},
    "collected_at": {"type": "string", "format": "date-time"},
    "responses": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "object"}}},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
