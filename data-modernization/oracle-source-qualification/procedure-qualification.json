      "source_sha256": "da5c0d595e1f5b42137f5a6a6e132dff87d1a036ba16f5fe4b2cc76bacc5ec9e",
      "status": "translated-bounded-subset",
      "target_sql": "CREATE OR REPLACE PROCEDURE carddemo.get_auth_status (\n  IN p_card_num VARCHAR,\n  OUT p_status VARCHAR\n)\nLANGUAGE plpgsql\nAS $$\nBEGIN\n  SELECT AUTH_FRAUD\n    INTO P_STATUS\n    FROM carddemo.authfrds\n   WHERE CARD_NUM = P_CARD_NUM;\nEXCEPTION\n  WHEN NO_DATA_FOUND THEN\n    P_STATUS := 'N';\nEND;\n$$;\n",
      "target_sql_sha256": "e29e31ed3132014d5b9338e9627dd4a5941e962e7a0d61a0b1cca171cdbe18d1"
    },
    {
      "dependencies": [
        "CARDDEMO.AUTHFRDS"
      ],
      "features": [
        "sql-rowcount",
        "update"
      ],
      "procedure_id": "CARDDEMO.SET_FRAUD_FLAG",
      "source_sha256": "4fea32adb4e00a091d4f8b1d74fd7ea2abc7c42572e0dd901669a91ab0588bc1",
      "status": "translated-bounded-subset",
      "target_sql": "CREATE OR REPLACE PROCEDURE carddemo.set_fraud_flag (\n  IN p_card_num VARCHAR,\n  IN p_reason VARCHAR,\n  OUT p_rows NUMERIC\n)\nLANGUAGE plpgsql\nAS $$\nBEGIN\n  UPDATE carddemo.authfrds\n     SET AUTH_FRAUD = 'Y',\n         AUTH_RESP_REASON = P_REASON\n   WHERE CARD_NUM = P_CARD_NUM;\n  GET DIAGNOSTICS P_ROWS = ROW_COUNT;\nEND;\n$$;\n",
      "target_sql_sha256": "b4043d277a0f484212e4b6923d89d70fb2811aa36d37251481477c2aea1423a0"
    },
    {
      "dependencies": [],
      "features": [
        "if-elsif-else",
        "raise-application-error"
      ],
      "procedure_id": "CARDDEMO.CLASSIFY_AMOUNT",
      "source_sha256": "acd973e84df616055a01373d699f00e5893882ae32e36055db929b732ebf0e08",
      "status": "translated-bounded-subset",
      "target_sql": "CREATE OR REPLACE PROCEDURE carddemo.classify_amount (\n  IN p_amount NUMERIC,\n  OUT p_class VARCHAR\n)\nLANGUAGE plpgsql\nAS $$\nBEGIN\n  IF P_AMOUNT < 0 THEN\n    RAISE EXCEPTION 'NEGATIVE_AMOUNT' USING ERRCODE = 'P0001';\n  ELSIF P_AMOUNT >= 1000 THEN\n    P_CLASS := 'HIGH';\n  ELSE\n    P_CLASS := 'STANDARD';\n  END IF;\nEND;\n$$;\n",
      "target_sql_sha256": "099ceb0ff0c69cc62afd46ee8e19a6b38889466d04156814a9901bed4833266e"
    },
    {
      "dependencies": [],
      "features": [
        "nvl"
      ],
      "procedure_id": "CARDDEMO.NORMALIZE_REASON",
      "source_sha256": "8bc528c63c7e8c440291c58902a858b6a9eb2ec932d6e0fb21345b5327bdda87",
      "status": "translated-bounded-subset",
      "target_sql": "CREATE OR REPLACE PROCEDURE carddemo.normalize_reason (\n  IN p_reason VARCHAR,\n  OUT p_result VARCHAR\n)\nLANGUAGE plpgsql\nAS $$\nBEGIN\n  P_RESULT := COALESCE(P_REASON, 'UNSPECIFIED');\nEND;\n$$;\n",
      "target_sql_sha256": "2ddf5a020f6761b1cceb48c96b5980a9800c1ea2d443b1081cf9aaea1b23102f"
    }
