{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/ims-conformance-receipt.schema.json",
  "title": "LIGHTYEAR IMS conformance receipt",
  "type": "object",
  "required": ["schema_version", "receipt_type", "corpus_id", "graph_content_sha256", "manifest_sha256", "corpus", "coverage", "results", "status", "claim_boundary", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_type": {"const": "lightyear-ims-conformance-receipt"},
    "corpus_id": {"const": "lightyear-ims-synthetic-conformance-v1"},
    "graph_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corpus": {
      "type": "object",
      "required": ["case_count", "positive_case_count", "targeted_boundary_case_count", "mutation_case_count", "passed_case_count", "blocked_case_count", "customer_source"],
      "properties": {
        "case_count": {"const": 40},
        "positive_case_count": {"const": 4},
        "targeted_boundary_case_count": {"const": 32},
        "mutation_case_count": {"const": 4},
        "passed_case_count": {"const": 36},
        "blocked_case_count": {"const": 4},
        "customer_source": {"const": false}
      },
      "additionalProperties": false
    },
    "coverage": {"type": "object"},
    "results": {"type": "array", "minItems": 40, "maxItems": 40},
    "status": {"const": "passed"},
    "claim_boundary": {
      "type": "object",
      "required": ["native_ims_qualified", "ims_tm_qualified", "fast_path_qualified", "dbrc_recovery_equivalent", "restart_equivalent", "ims_runtime_equivalent", "mainframe_equivalent", "production_ready"],
      "properties": {
        "native_ims_qualified": {"const": false},
        "ims_tm_qualified": {"const": false},
        "fast_path_qualified": {"const": false},
        "dbrc_recovery_equivalent": {"const": false},
        "restart_equivalent": {"const": false},
        "ims_runtime_equivalent": {"const": false},
        "mainframe_equivalent": {"const": false},
        "production_ready": {"const": false}
      },
      "additionalProperties": false
    },
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
