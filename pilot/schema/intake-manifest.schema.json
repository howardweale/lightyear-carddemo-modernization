{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/source-only-pilot-intake-v1.json",
  "title": "LIGHTYEAR source-only pilot intake",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_type",
    "pilot_id",
    "profile_sha256",
    "source_label",
    "approval",
    "scope",
    "files",
    "statistics",
    "source_tree_sha256",
    "limitations",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_type": {"const": "lightyear-source-only-pilot-intake"},
    "pilot_id": {"type": "string", "minLength": 1},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "source_label": {"type": "string", "minLength": 1, "maxLength": 80},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "approved_for_source_only_analysis", "customer_data_allowed", "runtime_credentials_allowed"],
      "properties": {
        "approval_id": {"type": "string", "minLength": 3},
        "approved_for_source_only_analysis": {"const": true},
        "customer_data_allowed": {"const": false},
        "runtime_credentials_allowed": {"const": false}
      }
    },
    "scope": {
      "const": {"live_system_contact": false, "read_only": true, "source_only": true}
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "bytes", "lines", "logical_sha256", "raw_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["cobol", "copybook", "pli", "jcl", "db2-ddl", "system-configuration"]},
          "bytes": {"type": "integer", "minimum": 0},
          "lines": {"type": "integer", "minimum": 0},
          "logical_sha256": {"$ref": "#/$defs/sha256"},
          "raw_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "statistics": {"type": "object"},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
