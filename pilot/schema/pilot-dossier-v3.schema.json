{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/source-only-pilot-dossier-v3.json",
  "title": "LIGHTYEAR assessed customer source-only pilot dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dossier_type", "pilot_id", "release", "intake_sha256", "preflight_sha256",
    "analysis_sha256", "assessment_sha256", "compatibility_policy_sha256", "estate",
    "modernization_plan", "capabilities", "proofs", "evidence_artifacts", "readiness_checks",
    "pilot_ready", "mainframe_equivalent", "production_ready", "claim_unlocked",
    "claims_prohibited", "limitations", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "dossier_type": {"const": "lightyear-source-only-pilot-dossier"},
    "pilot_id": {"const": "lightyear-carddemo-source-only-v0.31"},
    "release": {"const": "0.31.0"},
    "intake_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_sha256": {"$ref": "#/$defs/sha256"},
    "analysis_sha256": {"$ref": "#/$defs/sha256"},
    "assessment_sha256": {"$ref": "#/$defs/sha256"},
    "compatibility_policy_sha256": {"$ref": "#/$defs/sha256"},
    "estate": {"type": "object"},
    "modernization_plan": {"type": "object"},
    "capabilities": {"type": "array", "minItems": 6, "items": {"type": "object"}},
    "proofs": {"type": "object"},
    "evidence_artifacts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "readiness_checks": {"type": "object"},
    "pilot_ready": {"const": true},
    "mainframe_equivalent": {"const": false},
    "production_ready": {"const": false},
    "claim_unlocked": {"type": "string", "minLength": 1},
    "claims_prohibited": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
