{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schemas/oracle-transaction-cdc-coverage-receipt.schema.json",
  "title": "LIGHTYEAR Oracle transaction and CDC coverage receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "release",
    "base_catalog_sha256",
    "prior_plsql_corpus_sha256",
    "prior_plsql_receipt_sha256",
    "transaction_cdc_corpus_sha256",
    "catalogued_behavior_count",
    "catalogued_case_specification_count",
    "transaction_cdc_behavior_verified_count",
    "transaction_cdc_case_verified_count",
    "catalog_behavior_verified_count",
    "catalog_case_verified_count",
    "bounded_model_verified_behavior_count",
    "bounded_model_evidence_record_count",
    "remaining_catalog_case_count",
    "native_oracle_verified_behavior_count",
    "target_equivalent_behavior_count",
    "status",
    "native_oracle_execution_observed",
    "native_oracle_conformance",
    "live_concurrency_observed",
    "live_redo_or_logminer_observed",
    "live_privilege_enforcement_observed",
    "production_ready",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_type": {"const": "lightyear-oracle-transaction-cdc-coverage"},
    "release": {"const": "0.50.3"},
    "catalogued_behavior_count": {"const": 500},
    "catalogued_case_specification_count": {"const": 2000},
    "transaction_behavior_verified_count": {"const": 45},
    "operations_behavior_verified_count": {"const": 25},
    "transaction_cdc_topic_family_count": {"const": 14},
    "transaction_cdc_behavior_verified_count": {"const": 70},
    "transaction_cdc_case_verified_count": {"const": 280},
    "catalog_behavior_verified_count": {"const": 380},
    "catalog_case_verified_count": {"const": 1520},
    "bounded_model_verified_behavior_count": {"const": 381},
    "bounded_model_evidence_record_count": {"const": 1544},
    "remaining_catalog_case_count": {"const": 480},
    "native_oracle_verified_behavior_count": {"const": 0},
    "target_equivalent_behavior_count": {"const": 0},
    "status": {"const": "passed-bounded-transaction-cdc"},
    "native_oracle_execution_observed": {"const": false},
    "native_oracle_conformance": {"const": false},
    "live_concurrency_observed": {"const": false},
    "live_redo_or_logminer_observed": {"const": false},
    "live_privilege_enforcement_observed": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
