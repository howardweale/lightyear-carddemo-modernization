{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schemas/oracle-core-sql-coverage-receipt.schema.json",
  "title": "LIGHTYEAR Oracle core SQL coverage receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "release",
    "base_catalog_sha256",
    "corpus_sha256",
    "catalogued_behavior_count",
    "catalogued_case_specification_count",
    "core_behavior_verified_count",
    "catalog_case_verified_count",
    "bounded_model_verified_behavior_count",
    "remaining_catalog_case_count",
    "native_oracle_verified_behavior_count",
    "target_equivalent_behavior_count",
    "status",
    "native_oracle_execution_observed",
    "native_oracle_conformance",
    "production_ready",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_type": {"const": "lightyear-oracle-core-sql-coverage"},
    "release": {"const": "0.50.1"},
    "catalogued_behavior_count": {"const": 500},
    "catalogued_case_specification_count": {"const": 2000},
    "core_behavior_verified_count": {"const": 230},
    "catalog_case_verified_count": {"const": 920},
    "bounded_model_verified_behavior_count": {"const": 233},
    "remaining_catalog_case_count": {"const": 1080},
    "native_oracle_verified_behavior_count": {"const": 0},
    "target_equivalent_behavior_count": {"const": 0},
    "status": {"const": "passed-bounded-core-sql"},
    "native_oracle_execution_observed": {"const": false},
    "native_oracle_conformance": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
