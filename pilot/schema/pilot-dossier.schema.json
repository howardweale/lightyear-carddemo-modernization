{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/source-only-pilot-dossier-v1.json",
  "title": "LIGHTYEAR source-only pilot dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dossier_type",
    "pilot_id",
    "release",
    "intake_sha256",
    "preflight_sha256",
    "compatibility_policy_sha256",
    "estate",
    "capabilities",
    "proofs",
    "evidence_artifacts",
    "readiness_checks",
    "pilot_ready",
    "mainframe_equivalent",
    "production_ready",
    "claim_unlocked",
    "claims_prohibited",
    "limitations",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dossier_type": {"const": "lightyear-source-only-pilot-dossier"},
    "pilot_id": {"type": "string"},
    "release": {"const": "0.29.0"},
    "intake_sha256": {"$ref": "#/$defs/sha256"},
    "preflight_sha256": {"$ref": "#/$defs/sha256"},
    "compatibility_policy_sha256": {"$ref": "#/$defs/sha256"},
    "estate": {"type": "object"},
    "capabilities": {"type": "array", "minItems": 6, "items": {"type": "object"}},
    "proofs": {"type": "object"},
    "evidence_artifacts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "readiness_checks": {"type": "object"},
    "pilot_ready": {"const": true},
    "mainframe_equivalent": {"const": false},
    "production_ready": {"const": false},
    "claim_unlocked": {"type": "string"},
    "claims_prohibited": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
