{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/oracle-procedure-compatibility-ledger.schema.json",
  "title": "LIGHTYEAR Oracle procedure compatibility ledger",
  "type": "object",
  "required": ["schema_version", "ledger_type", "source_sha256", "classifications", "entries", "statistics", "qualification_blocked", "production_ready", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "ledger_type": {"const": "lightyear-oracle-procedure-compatibility-ledger"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classifications": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true},
    "entries": {"type": "array", "minItems": 15},
    "statistics": {"type": "object"},
    "qualification_blocked": {"const": true},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
