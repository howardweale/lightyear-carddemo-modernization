{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/governed-pilot-selection-v1.json",
  "title": "LIGHTYEAR governed pilot selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "selection_type", "selection_id", "request_sha256",
    "assessment_sha256", "dossier_sha256", "selected_cluster", "decision",
    "boundary_dispositions", "approval_record", "selection_ready",
    "deferred_boundary_reference_ids", "authorization", "claim_boundary",
    "limitations", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "selection_type": {"const": "lightyear-governed-pilot-selection"},
    "selection_id": {"type": "string", "minLength": 1},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "assessment_sha256": {"$ref": "#/$defs/sha256"},
    "dossier_sha256": {"$ref": "#/$defs/sha256"},
    "selected_cluster": {"type": "object"},
    "decision": {"type": "object"},
    "boundary_dispositions": {"type": "array", "items": {"type": "object"}},
    "approval_record": {"type": "object"},
    "selection_ready": {"type": "boolean"},
    "deferred_boundary_reference_ids": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_package_generation_allowed", "factory_dispatch_allowed",
        "native_execution_allowed", "production_release_allowed"
      ],
      "properties": {
        "work_package_generation_allowed": {"type": "boolean"},
        "factory_dispatch_allowed": {"const": false},
        "native_execution_allowed": {"const": false},
        "production_release_allowed": {"const": false}
      }
    },
    "claim_boundary": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
