{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schema/factory/evaluation-catalog-1.0.json",
  "title": "LIGHTYEAR work-cell evaluation catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "evaluation_class", "description", "minimum_repair_rate", "target_path", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "evaluation_class": {"enum": ["public-calibration", "sealed-holdout"]},
    "description": {"type": "string"},
    "minimum_repair_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "target_path": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "expectation": {"enum": ["reject-and-repair", "accept-unchanged"]},
          "before": {"type": "string", "minLength": 1},
          "after": {"type": "string"},
          "relevant_evidence_owner_ids": {"type": "array", "items": {"type": "string"}},
          "forbidden_public_markers": {"type": "array", "items": {"type": "string"}}
        },
        "allOf": [{
          "if": {"properties": {"expectation": {"const": "accept-unchanged"}}, "required": ["expectation"]},
          "then": {},
          "else": {"required": ["before", "after"]}
        }]
      }
    }
  }
}
