{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schemas/cloudbank/production-readiness.schema.json",
  "title": "CloudBank production-readiness rehearsal readiness",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "release",
    "bindings",
    "acceptance_contract_sha256",
    "gate_status",
    "production_like_rehearsal_complete",
    "cutover_rehearsal_complete",
    "rollback_rehearsal_complete",
    "production_deployed",
    "whole_application_equivalent",
    "migration_complete",
    "production_ready",
    "content_sha256"
  ],
  "properties": {
    "receipt_type": {
      "const": "lightyear-cloudbank-production-readiness-rehearsal-readiness"
    },
    "release": {"const": "0.65.0"},
    "gate_status": {
      "const": "ready-for-signed-ms64-and-authorized-non-production-rehearsal"
    },
    "production_like_rehearsal_complete": {"const": false},
    "cutover_rehearsal_complete": {"const": false},
    "rollback_rehearsal_complete": {"const": false},
    "production_deployed": {"const": false},
    "whole_application_equivalent": {"const": false},
    "migration_complete": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
