{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/adapter-conformance-receipt.schema.json",
  "title": "LIGHTYEAR database adapter conformance receipt",
  "type": "object",
  "required": ["schema_version", "receipt_type", "semantic_core_version", "model_sha256", "ledger_sha256", "adapters", "status", "production_qualification_implied", "production_ready", "content_sha256"],
  "properties": {
    "receipt_type": {"const": "lightyear-adapter-conformance"},
    "status": {"enum": ["passed", "failed"]},
    "production_qualification_implied": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
