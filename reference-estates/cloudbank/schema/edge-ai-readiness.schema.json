{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schemas/cloudbank/edge-ai-readiness.schema.json",
  "title": "CloudBank edge and AI readiness",
  "type": "object",
  "required": [
    "schema_version", "receipt_type", "release", "gate_status",
    "remaining_service_workcells_complete", "eight_service_target_assembled",
    "real_credit_decision_equivalent", "model_quality_qualified",
    "whole_application_equivalent", "migration_complete", "production_ready", "content_sha256"
  ],
  "properties": {
    "receipt_type": {"const": "lightyear-cloudbank-edge-ai-readiness"},
    "release": {"const": "0.64.0"},
    "gate_status": {"const": "ready-for-signed-ms63-ms57-edge-ai-run"},
    "remaining_service_workcells_complete": {"const": false},
    "eight_service_target_assembled": {"const": false},
    "real_credit_decision_equivalent": {"const": false},
    "model_quality_qualified": {"const": false},
    "whole_application_equivalent": {"const": false},
    "migration_complete": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
