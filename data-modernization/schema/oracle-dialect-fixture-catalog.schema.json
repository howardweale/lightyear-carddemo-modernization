{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schemas/oracle-dialect-fixture-catalog.schema.json",
  "title": "LIGHTYEAR Oracle dialect fixture catalog",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_type",
    "corpus_id",
    "official_sample_schema_commit",
    "fixtures",
    "fixture_count",
    "case_count",
    "native_oracle_executed",
    "production_ready",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "catalog_type": {"const": "lightyear-oracle-dialect-fixture-catalog"},
    "corpus_id": {"type": "string", "minLength": 1},
    "official_sample_schema_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "fixtures": {"type": "array", "minItems": 8, "maxItems": 8},
    "fixture_count": {"const": 8},
    "case_count": {"const": 24},
    "native_oracle_executed": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
