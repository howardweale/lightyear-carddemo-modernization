{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorydark.ai/schemas/pli-development-receipt.schema.json",
  "title": "LIGHTYEAR mixed PL/I development receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "workload_id",
    "evidence_class",
    "bindings",
    "checks",
    "development_ready",
    "mainframe_equivalent",
    "production_ready",
    "status",
    "unresolved_gaps",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_type": {"const": "lightyear-pli-mixed-development-proof"},
    "workload_id": {"const": "workload:carddemo-pli-auth-risk"},
    "evidence_class": {"const": "local_observed"},
    "bindings": {"type": "object", "minProperties": 10, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "checks": {
      "type": "object",
      "minProperties": 8,
      "maxProperties": 8,
      "additionalProperties": {"type": "boolean"}
    },
    "development_ready": {"const": true},
    "mainframe_equivalent": {"const": false},
    "production_ready": {"const": false},
    "status": {"const": "passed"},
    "unresolved_gaps": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
