{
  "schema_version": "1.0",
  "backend": "sqlite-wal-reference",
  "default_lease_seconds": 60,
  "maximum_lease_seconds": 3600,
  "default_retry_backoff_seconds": 5,
  "approval_consumption": "exactly-once",
  "receipt_index": "sha256",
  "event_integrity": "sha256-chain",
  "production_adapter": "postgresql-object-store"
}
