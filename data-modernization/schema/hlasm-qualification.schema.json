{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/hlasm-qualification.schema.json",
  "title": "LIGHTYEAR HLASM qualification",
  "type": "object",
  "required": ["schema_version", "qualification_type", "qualification_id", "bindings", "inventory", "qualification_gates", "required_native_evidence", "qualification_mechanism_ready", "development_ready", "native_hlasm_qualified", "assembler_qualified", "binder_qualified", "le_linkage_qualified", "system_services_qualified", "runtime_equivalent", "mainframe_equivalent", "production_ready", "claim_unlocked", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "qualification_type": {"const": "lightyear-hlasm-qualification"},
    "qualification_id": {"const": "carddemo-hlasm-v0.41"},
    "bindings": {"type": "object"},
    "inventory": {"type": "object"},
    "qualification_gates": {"type": "array", "minItems": 11, "maxItems": 11},
    "required_native_evidence": {"type": "array", "minItems": 8, "uniqueItems": true},
    "qualification_mechanism_ready": {"const": true},
    "development_ready": {"const": true},
    "native_hlasm_qualified": {"const": false},
    "assembler_qualified": {"const": false},
    "binder_qualified": {"const": false},
    "le_linkage_qualified": {"const": false},
    "system_services_qualified": {"const": false},
    "runtime_equivalent": {"const": false},
    "mainframe_equivalent": {"const": false},
    "production_ready": {"const": false},
    "claim_unlocked": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
