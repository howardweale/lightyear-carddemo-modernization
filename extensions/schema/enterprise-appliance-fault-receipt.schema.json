{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schema/enterprise-appliance-fault-receipt-1.0.json",
  "title": "LIGHTYEAR enterprise collector fault laboratory receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "evidence_class", "status", "scenario_count", "all_expected_faults_detected", "results", "credential_material_retained", "live_observed", "production_ready", "limitations", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_type": {"const": "lightyear-enterprise-collector-fault-laboratory"},
    "evidence_class": {"const": "simulated-resilience"},
    "status": {"enum": ["passed", "blocked"]},
    "scenario_count": {"const": 8},
    "all_expected_faults_detected": {"type": "boolean"},
    "results": {"type": "array", "minItems": 8, "maxItems": 8},
    "credential_material_retained": {"const": false},
    "live_observed": {"const": false},
    "production_ready": {"const": false},
    "limitations": {"type": "array", "minItems": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
