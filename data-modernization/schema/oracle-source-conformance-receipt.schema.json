{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/oracle-source-conformance-receipt.schema.json",
  "title": "LIGHTYEAR Oracle source-adapter conformance receipt",
  "type": "object",
  "required": ["schema_version", "receipt_type", "adapter", "model_sha256", "profile_contract_sha256", "ledger_sha256", "checks", "status", "catalog_observed", "profile_observed", "redo_observed", "transaction_observed", "production_ready", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_type": {"const": "lightyear-oracle-source-adapter-conformance"},
    "adapter": {"type": "object"},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checks": {"type": "object"},
    "status": {"const": "passed"},
    "catalog_observed": {"const": false},
    "profile_observed": {"const": false},
    "redo_observed": {"const": false},
    "transaction_observed": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
