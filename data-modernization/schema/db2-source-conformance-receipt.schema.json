{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/db2-source-conformance-receipt.schema.json",
  "title": "LIGHTYEAR DB2 source adapter conformance receipt",
  "type": "object",
  "required": ["schema_version", "receipt_type", "adapter", "model_sha256", "ledger_sha256", "checks", "status", "catalog_observed", "profile_observed", "cdc_observed", "mainframe_equivalent", "production_ready", "content_sha256"],
  "properties": {
    "receipt_type": {"const": "lightyear-db2-source-adapter-conformance"},
    "status": {"const": "passed"},
    "catalog_observed": {"const": false},
    "profile_observed": {"const": false},
    "cdc_observed": {"const": false},
    "mainframe_equivalent": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
