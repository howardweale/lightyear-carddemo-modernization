{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schemas/oracle-schema-structured-coverage-receipt.schema.json",
  "title": "LIGHTYEAR Oracle schema and structured-data coverage receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "release",
    "base_catalog_sha256",
    "prior_transaction_cdc_corpus_sha256",
    "prior_transaction_cdc_receipt_sha256",
    "schema_structured_corpus_sha256",
    "catalogued_behavior_count",
    "catalogued_case_specification_count",
    "schema_structured_behavior_verified_count",
    "schema_structured_case_verified_count",
    "catalog_behavior_verified_count",
    "catalog_case_verified_count",
    "bounded_model_verified_behavior_count",
    "bounded_model_evidence_record_count",
    "remaining_catalog_case_count",
    "native_oracle_verified_behavior_count",
    "target_equivalent_behavior_count",
    "status",
    "all_catalog_cases_implemented",
    "bounded_catalog_execution_complete",
    "native_oracle_execution_observed",
    "native_oracle_conformance",
    "live_schema_or_dml_observed",
    "live_lob_json_xml_or_object_observed",
    "production_ready",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_type": {"const": "lightyear-oracle-schema-structured-coverage"},
    "release": {"const": "0.50.4"},
    "catalogued_behavior_count": {"const": 500},
    "catalogued_case_specification_count": {"const": 2000},
    "schema_dml_behavior_verified_count": {"const": 50},
    "schema_object_behavior_verified_count": {"const": 35},
    "structured_data_behavior_verified_count": {"const": 35},
    "schema_structured_topic_family_count": {"const": 24},
    "schema_structured_behavior_verified_count": {"const": 120},
    "schema_structured_case_verified_count": {"const": 480},
    "catalog_behavior_verified_count": {"const": 500},
    "catalog_case_verified_count": {"const": 2000},
    "bounded_model_verified_behavior_count": {"const": 500},
    "bounded_model_evidence_record_count": {"const": 2024},
    "remaining_catalog_case_count": {"const": 0},
    "native_oracle_verified_behavior_count": {"const": 0},
    "target_equivalent_behavior_count": {"const": 0},
    "status": {"const": "passed-bounded-complete-catalog"},
    "all_catalog_cases_implemented": {"const": true},
    "bounded_catalog_execution_complete": {"const": true},
    "native_oracle_execution_observed": {"const": false},
    "native_oracle_conformance": {"const": false},
    "live_schema_or_dml_observed": {"const": false},
    "live_lob_json_xml_or_object_observed": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
