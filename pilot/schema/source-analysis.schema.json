{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/customer-source-analysis-v1.json",
  "title": "LIGHTYEAR customer source analysis receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_type",
    "pilot_id",
    "intake_sha256",
    "source_tree_sha256",
    "graph_id",
    "graph_schema_version",
    "graph_content_sha256",
    "relationship_ontology",
    "statistics",
    "coverage",
    "declared_entities_by_kind",
    "unresolved_references",
    "unresolved_reference_count",
    "quality_gates",
    "analysis_ready",
    "analysis_scope",
    "behavior_proven",
    "live_system_contact",
    "mainframe_equivalent",
    "production_ready",
    "limitations",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "analysis_type": {"const": "lightyear-customer-source-analysis"},
    "pilot_id": {"type": "string", "minLength": 1},
    "intake_sha256": {"$ref": "#/$defs/sha256"},
    "source_tree_sha256": {"$ref": "#/$defs/sha256"},
    "graph_id": {"type": "string", "minLength": 1},
    "graph_schema_version": {"type": "string", "minLength": 1},
    "graph_content_sha256": {"$ref": "#/$defs/sha256"},
    "relationship_ontology": {"type": "object"},
    "statistics": {"type": "object"},
    "coverage": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "declared_entities_by_kind": {"type": "object"},
    "unresolved_references": {"type": "array", "items": {"type": "object"}},
    "unresolved_reference_count": {"type": "integer", "minimum": 0},
    "quality_gates": {"type": "object"},
    "analysis_ready": {"const": true},
    "analysis_scope": {"const": "bounded-source-static-analysis"},
    "behavior_proven": {"const": false},
    "live_system_contact": {"const": false},
    "mainframe_equivalent": {"const": false},
    "production_ready": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
