{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schema/factory/evaluation-receipt-2.0.json",
  "title": "LIGHTYEAR model work-cell evaluation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_type", "evaluation_id", "evaluation_class",
    "catalog_sha256", "catalog_validation_sha256", "planned_cases", "completed_cases",
    "cases", "categories", "mutation_cases", "clean_cases",
    "baselines_rejected", "autonomously_repaired", "repair_rate",
    "correct_no_changes", "correct_no_change_rate",
    "minimum_repair_rate", "false_acceptances", "status", "results", "totals",
    "stopped_reason", "policy", "quality_gate", "sealed_binding", "limitations", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "receipt_type": {"const": "lightyear-model-workcell-evaluation"},
    "evaluation_id": {"type": "string"},
    "evaluation_class": {"enum": ["public-calibration", "sealed-holdout"]},
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalog_validation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "planned_cases": {"type": "integer", "minimum": 1},
    "completed_cases": {"type": "integer", "minimum": 0},
    "cases": {"type": "integer", "minimum": 0},
    "categories": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "mutation_cases": {"type": "integer", "minimum": 0},
    "clean_cases": {"type": "integer", "minimum": 0},
    "baselines_rejected": {"type": "integer", "minimum": 0},
    "autonomously_repaired": {"type": "integer", "minimum": 0},
    "repair_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "correct_no_changes": {"type": "integer", "minimum": 0},
    "correct_no_change_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "minimum_repair_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "false_acceptances": {"type": "integer", "minimum": 0},
    "status": {"enum": ["passed", "failed", "stopped"]},
    "stopped_reason": {"type": ["object", "null"]},
    "policy": {"type": "object"},
    "quality_gate": {"type": "object"},
    "sealed_binding": {"type": ["object", "null"]},
    "results": {"type": "array", "items": {"type": "object"}},
    "totals": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
