{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schemas/cloudbank/native-transaction-wave-readiness.schema.json",
  "title": "CloudBank native transaction-wave readiness",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "release",
    "bindings",
    "gate_status",
    "integrated_target_generated",
    "native_transaction_wave_observed",
    "native_lra_replacement_observed",
    "production_identity_qualified",
    "oracle_postgresql_equivalent",
    "whole_application_equivalent",
    "migration_complete",
    "production_ready",
    "content_sha256"
  ],
  "properties": {
    "receipt_type": {"const": "lightyear-cloudbank-native-transaction-wave-readiness"},
    "release": {"const": "0.60.0"},
    "gate_status": {"const": "ready-for-signed-ms59-and-native-integrated-run"},
    "integrated_target_generated": {"const": true},
    "native_transaction_wave_observed": {"const": false},
    "native_lra_replacement_observed": {"const": false},
    "production_identity_qualified": {"const": false},
    "oracle_postgresql_equivalent": {"const": false},
    "whole_application_equivalent": {"const": false},
    "migration_complete": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
