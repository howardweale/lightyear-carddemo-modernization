{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorydark.ai/schemas/capability-readiness-1.3.json",
  "title": "FactoryDark Unified Mainframe Capability Readiness",
  "type": "object",
  "required": ["schema_version", "analysis_type", "graph_content_sha256", "truth_boundary", "evidence_bindings", "capabilities", "collection_mechanisms", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.3"},
    "analysis_type": {"const": "factorydark-mainframe-capability-readiness"},
    "graph_content_sha256": {"$ref": "#/$defs/hash"},
    "truth_boundary": {"type": "string", "minLength": 1},
    "content_sha256": {"$ref": "#/$defs/hash"},
    "evidence_bindings": {
      "type": "object",
      "required": ["canonical_graph_sha256", "extension_catalog_sha256", "pli_fragment_sha256", "pli_coverage_receipt_sha256", "pli_development_receipt_sha256", "pli_build_receipt_sha256", "pli_build_attestation_sha256", "postgres_data_receipt_sha256", "oracle_data_receipt_sha256", "mainframe_campaign_receipt_sha256"],
      "properties": {
        "canonical_graph_sha256": {"$ref": "#/$defs/hash"},
        "extension_catalog_sha256": {"$ref": "#/$defs/hash"},
        "pli_fragment_sha256": {"$ref": "#/$defs/hash"},
        "pli_coverage_receipt_sha256": {"$ref": "#/$defs/hash"},
        "pli_development_receipt_sha256": {"$ref": "#/$defs/hash"},
        "pli_build_receipt_sha256": {"$ref": "#/$defs/hash"},
        "pli_build_attestation_sha256": {"$ref": "#/$defs/hash"},
        "postgres_data_receipt_sha256": {"$ref": "#/$defs/hash"},
        "oracle_data_receipt_sha256": {"$ref": "#/$defs/hash"},
        "mainframe_campaign_receipt_sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/capability"}
    },
    "collection_mechanisms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["mechanism", "status", "evidence_class", "live_observed", "production_ready", "adapters", "receipt_sha256"],
        "properties": {
          "mechanism": {"const": "Mainframe Access Campaign"},
          "status": {"enum": ["live_observed", "simulated_ready", "blocked"]},
          "evidence_class": {"enum": ["live", "recorded", "simulated", "inferred", "unverified"]},
          "live_observed": {"type": "boolean"},
          "production_ready": {"const": false},
          "adapters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "receipt_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability": {
      "type": "object",
      "required": ["technology", "capability_kind", "discovery_ready", "development_ready", "mainframe_equivalent", "support_claim", "gates"],
      "properties": {
        "technology": {"enum": ["CICS", "VSAM", "IMS", "HLASM", "PL/I", "Db2/Data"]},
        "capability_kind": {"enum": ["runtime", "language", "data"]},
        "discovery_ready": {"type": "boolean"},
        "development_ready": {"type": "boolean"},
        "mainframe_equivalent": {"type": "boolean"},
        "support_claim": {"type": "string"},
        "breadth": {
          "type": "object",
          "required": ["scope", "corpus_case_count", "positive_case_count", "blocked_case_count", "mutation_case_count", "supported_construct_count", "explicit_gap_count", "customer_source", "runtime_evidence"],
          "properties": {
            "scope": {"const": "synthetic-static-supported-subset"},
            "corpus_case_count": {"type": "integer", "minimum": 20},
            "positive_case_count": {"type": "integer", "minimum": 1},
            "blocked_case_count": {"type": "integer", "minimum": 1},
            "mutation_case_count": {"type": "integer", "minimum": 5},
            "supported_construct_count": {"type": "integer", "minimum": 20},
            "explicit_gap_count": {"type": "integer", "minimum": 1},
            "customer_source": {"const": false},
            "runtime_evidence": {"const": false}
          },
          "additionalProperties": false
        },
        "gates": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["gate", "name", "status", "evidence"],
            "properties": {
              "gate": {"type": "integer", "minimum": 1, "maximum": 8},
              "name": {"type": "string"},
              "status": {"enum": ["passed", "mechanism_ready", "blocked", "not_started"]},
              "evidence": {"type": "array", "items": {"type": "string"}},
              "gap": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
