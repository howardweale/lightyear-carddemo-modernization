{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schema/durable-conformance.schema.json",
  "title": "LIGHTYEAR durable control-plane conformance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "status", "evidence_class", "reference_backend", "plan_sha256", "policy_sha256", "checks", "statistics", "limitations", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_type": {"const": "lightyear-durable-control-plane-conformance"},
    "status": {"enum": ["passed", "failed"]},
    "evidence_class": {"const": "synthetic-crash-recovery-conformance"},
    "reference_backend": {"const": "sqlite-wal"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "statistics": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
