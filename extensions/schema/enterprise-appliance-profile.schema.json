{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schema/enterprise-appliance-profile-1.0.json",
  "title": "LIGHTYEAR enterprise collection appliance profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "appliance_id", "campaign_profile_sha256", "authentication", "retry", "pagination", "checkpoint", "retention", "bounds", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "appliance_id": {"type": "string", "minLength": 1},
    "campaign_profile_sha256": {"$ref": "#/$defs/hash"},
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_modes", "minimum_tls"],
      "properties": {
        "accepted_modes": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["bearer-env", "mtls-bearer-env", "externally-issued-oauth-bearer-env"]}},
        "minimum_tls": {"const": "1.2"}
      }
    },
    "retry": {"type": "object"},
    "pagination": {"type": "object"},
    "checkpoint": {"type": "object"},
    "retention": {"type": "object"},
    "bounds": {"type": "object"},
    "content_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
