    "target_postgresql_application_observed": {"const": true},
    "native_dual_run_observed": {"const": true},
    "application_refactored": {"const": true},
    "bounded_customer_application_equivalent": {"const": true},
    "human_promotion_authorized": {"const": false},
    "target_equivalent": {"const": false},
    "migration_complete": {"const": false},
    "production_ready": {"const": false}
