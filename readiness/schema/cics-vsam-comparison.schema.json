{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorydark.ai/schema/cics-vsam-comparison.schema.json",
  "type": "object",
  "required": ["schema_version", "comparison_type", "baseline_sha256", "candidate_sha256", "differences", "behavior_match", "mainframe_baseline", "status", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "comparison_type": {"const": "lightyear-cics-vsam-differential"},
    "behavior_match": {"type": "boolean"},
    "mainframe_baseline": {"type": "boolean"},
    "status": {"enum": ["passed", "failed"]},
    "differences": {"type": "array"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
