{
  "schema_version": "1.0",
  "id": "lightyear:carddemo:hardened-execution",
  "version": "1.0",
  "runtime": {
    "allowed": ["docker", "podman"],
    "image": "python:3.13-alpine",
    "image_digest": "399babc8b49529dabfd9c922f2b5eea81d611e4512e3ed250d75bd2e7683f4b0",
    "allowed_commands": ["python3"],
    "allowed_environment": [
      "LIGHTYEAR_FACTORY_WORKSPACE",
      "LIGHTYEAR_NETWORK_POLICY",
      "PYTHONPATH"
    ]
  },
  "isolation": {
    "network_mode": "none",
    "read_only_root": true,
    "workspace_read_only": true,
    "run_as_user": "65532:65532",
    "cap_drop_all": true,
    "no_new_privileges": true,
    "pids_limit": 128,
    "memory_mb": 512,
    "cpus": 1.0,
    "tmpfs_mb": 64
  },
  "admission": {
    "required": true,
    "signature_algorithm": "HMAC-SHA256",
    "trusted_key_ids": ["lightyear-release-operator"],
    "max_ttl_seconds": 3600
  },
  "identities": {
    "credential_ttl_seconds": 900,
    "roles": {
      "planner": {
        "actions": ["factory:plan"]
      },
      "builder": {
        "actions": ["factory:build"]
      },
      "provider": {
        "actions": ["secret:lease:OPENAI_API_KEY"]
      },
      "verifier": {
        "actions": ["factory:verify"]
      }
    }
  },
  "secrets": {
    "allowed_names": ["OPENAI_API_KEY"],
    "persist_values": false
  }
}
