{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schema/mainframe-access-profile.schema.json",
  "additionalProperties": false,
  "properties": {
    "adapters": {
      "additionalProperties": false,
      "properties": {
        "lightyear.cics-cmci": {"$ref": "#/$defs/adapter"},
        "lightyear.db2-zos-catalog": {"$ref": "#/$defs/adapter"},
        "lightyear.zosmf-jobs": {"$ref": "#/$defs/adapter"}
      },
      "required": ["lightyear.cics-cmci", "lightyear.db2-zos-catalog", "lightyear.zosmf-jobs"],
      "type": "object"
    },
    "bounds": {
      "additionalProperties": false,
      "properties": {
        "max_response_bytes": {"maximum": 1048576, "minimum": 1024, "type": "integer"},
        "timeout_seconds": {"maximum": 120, "minimum": 1, "type": "integer"}
      },
      "required": ["max_response_bytes", "timeout_seconds"],
      "type": "object"
    },
    "profile_id": {"maxLength": 128, "minLength": 1, "type": "string"},
    "schema_version": {"const": "1.0"},
    "source_system": {"maxLength": 128, "minLength": 1, "type": "string"}
  },
  "required": ["schema_version", "profile_id", "source_system", "adapters", "bounds"],
  "type": "object",
  "$defs": {
    "adapter": {
      "additionalProperties": false,
      "properties": {
        "entities": {
          "additionalProperties": {"minLength": 1, "type": "string"},
          "minProperties": 1,
          "type": "object"
        },
        "path": {"maxLength": 512, "pattern": "^/", "type": "string"}
      },
      "required": ["path", "entities"],
      "type": "object"
    }
  }
}
