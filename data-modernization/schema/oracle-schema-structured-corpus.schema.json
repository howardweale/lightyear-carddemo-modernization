{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schemas/oracle-schema-structured-corpus.schema.json",
  "title": "LIGHTYEAR Oracle schema and structured-data bounded conformance corpus",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_type",
    "release",
    "base_catalog_sha256",
    "domain_ids",
    "topic_family_count",
    "behavior_count",
    "case_count",
    "cases_by_domain",
    "cases_by_topic",
    "results",
    "status",
    "native_oracle_execution_observed",
    "target_equivalence_observed",
    "production_ready",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "corpus_type": {"const": "lightyear-oracle-schema-structured-bounded-conformance"},
    "release": {"const": "0.50.4"},
    "domain_ids": {"const": ["schema-dml", "schema-objects", "structured-data"]},
    "topic_family_count": {"const": 24},
    "behavior_count": {"const": 120},
    "case_count": {"const": 480},
    "cases_by_domain": {
      "const": {"schema-dml": 200, "schema-objects": 140, "structured-data": 140}
    },
    "results": {"type": "array", "minItems": 480, "maxItems": 480},
    "status": {"const": "passed-bounded-model"},
    "native_oracle_execution_observed": {"const": false},
    "target_equivalence_observed": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
