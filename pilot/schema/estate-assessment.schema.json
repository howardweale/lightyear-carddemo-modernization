{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/customer-estate-assessment-v1.json",
  "title": "LIGHTYEAR customer estate assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "assessment_type", "pilot_id", "intake_sha256", "analysis_sha256",
    "graph_content_sha256", "assessment_policy_sha256", "method", "statistics", "clusters",
    "planning_waves", "evidence_backlog", "decision_boundary", "claim_unlocked", "limitations",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "assessment_type": {"const": "lightyear-customer-estate-assessment"},
    "pilot_id": {"type": "string", "minLength": 1},
    "intake_sha256": {"$ref": "#/$defs/sha256"},
    "analysis_sha256": {"$ref": "#/$defs/sha256"},
    "graph_content_sha256": {"$ref": "#/$defs/sha256"},
    "assessment_policy_sha256": {"$ref": "#/$defs/sha256"},
    "method": {"const": "deterministic-undirected-connected-components"},
    "statistics": {"type": "object"},
    "clusters": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "planning_waves": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object"}},
    "evidence_backlog": {"type": "array", "items": {"type": "string"}},
    "decision_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_plan_only", "business_priority_inferred", "automatic_factory_dispatch",
        "authorized_execution_observed", "mainframe_equivalent", "production_ready"
      ],
      "properties": {
        "advisory_plan_only": {"const": true},
        "business_priority_inferred": {"const": false},
        "automatic_factory_dispatch": {"const": false},
        "authorized_execution_observed": {"const": false},
        "mainframe_equivalent": {"const": false},
        "production_ready": {"const": false}
      }
    },
    "claim_unlocked": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
