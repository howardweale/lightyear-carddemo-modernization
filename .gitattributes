# Preserve the pinned Oracle-authored corpus byte for byte, including upstream whitespace.
reference-estates/oracle/corpus/** -whitespace

# Preserve exact third-party license and notice bytes for hash-verifiable attribution.
LICENSES/** -whitespace

# Immutable signed MS71 exports retain their original bytes on every platform.
docs/receipts/ms71-20260912a/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve original signed AlloyDB platform evidence and its export byte hashes.
docs/receipts/alloydb-platform-20260912a/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve signed paired-campaign export bytes and the public-key fingerprint.
docs/receipts/oracle26ai-alloydb-number-20260917/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve the native 100-pair family journals, signatures and public key bytes.
docs/receipts/oracle26ai-alloydb-core100-20260917/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve both native 260-pair attempts, signatures and operational readback.
docs/receipts/oracle26ai-alloydb-types260-20260917/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Copybook fingerprints and third-party attribution preserve exact input bytes.
spec/mainframe/copybooks/** -text -whitespace

# The packed probe is a fingerprinted fixture, including its line ending.
spec/mainframe/packed-golden.hex -text

# Preserve native iDempiere capture, log and controller bytes bound by the receipt.
docs/calibration/idempiere-runtime/evidence/** -text -whitespace

# Preserve reconciliation evidence bytes and raw difference witnesses.
docs/calibration/idempiere-reconciliation/evidence/** -text -whitespace
docs/calibration/idempiere-reconciliation/evidence.zip binary

# Preserve the exact executed application harness bytes bound by native receipts.
docs/calibration/idempiere-application/LightyearJourneyTest.java -text -whitespace

# Preserve exact executed boundary and operations harnesses for receipt replay.
docs/calibration/idempiere-boundaries/*.java -text -whitespace
