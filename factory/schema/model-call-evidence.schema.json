{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schema/factory/model-call-evidence-1.0.json",
  "title": "LIGHTYEAR model-call evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_type", "provider", "model", "role", "store",
    "strict_schema", "request_sha256", "response_sha256", "input_tokens",
    "output_tokens", "estimated_cost_usd", "cost_estimate_available", "elapsed_ms", "call_sequence",
    "request_bytes", "response_bytes", "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_type": {"const": "lightyear-model-call"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "role": {"enum": ["planner", "builder", "failure_analyst"]},
    "store": {"const": false},
    "strict_schema": {"const": true},
    "max_output_tokens": {"type": "integer", "minimum": 1},
    "input_token_preflight": {"type": "boolean"},
    "input_tokens_preflight": {"type": ["integer", "null"], "minimum": 0},
    "max_input_tokens_per_call": {"type": "integer", "minimum": 1000},
    "token_count_attempts": {"type": "integer", "minimum": 0},
    "token_count_retry_count": {"type": "integer", "minimum": 0},
    "token_count_retries": {"type": "array", "items": {"type": "object"}},
    "token_count_rate_limits": {
      "type": "object", "additionalProperties": {"type": "string"}
    },
    "token_count_request_sha256": {
      "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
    },
    "attempts": {"type": "integer", "minimum": 1},
    "retry_count": {"type": "integer", "minimum": 0},
    "retries": {"type": "array", "items": {"type": "object"}},
    "rate_limits": {"type": "object", "additionalProperties": {"type": "string"}},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_manifest": {
      "type": "object",
      "required": [
        "instruction_sha256", "payload_sha256", "payload_keys",
        "selected_evidence_capsule_ids", "selected_graph_node_ids", "content_sha256"
      ],
      "properties": {
        "instruction_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "payload_keys": {"type": "array", "items": {"type": "string"}},
        "context_type": {"type": ["string", "null"]},
        "context_sha256": {"type": ["string", "null"]},
        "context_statistics": {"type": "object"},
        "selected_evidence_capsule_ids": {
          "type": "array", "items": {"type": "string"}
        },
        "selected_graph_node_ids": {
          "type": "array", "items": {"type": "string"}
        },
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "estimated_cost_usd": {"type": "number", "minimum": 0},
    "cost_estimate_available": {"type": "boolean"},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "call_sequence": {"type": "integer", "minimum": 1},
    "request_bytes": {"type": "integer", "minimum": 1},
    "response_bytes": {"type": "integer", "minimum": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
