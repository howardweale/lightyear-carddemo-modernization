{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schemas/cloudbank/transaction-core-readiness.schema.json",
  "title": "CloudBank PostgreSQL transaction-core readiness",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "release",
    "bindings",
    "gate_status",
    "target_code_generated",
    "native_transaction_wave_observed",
    "oracle_postgresql_equivalent",
    "whole_application_equivalent",
    "migration_complete",
    "production_ready",
    "content_sha256"
  ],
  "properties": {
    "receipt_type": {"const": "lightyear-cloudbank-transaction-core-readiness"},
    "release": {"const": "0.59.0"},
    "gate_status": {"const": "ready-for-signed-ms58-and-native-postgresql-run"},
    "target_code_generated": {"const": true},
    "native_transaction_wave_observed": {"const": false},
    "oracle_postgresql_equivalent": {"const": false},
    "whole_application_equivalent": {"const": false},
    "migration_complete": {"const": false},
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
