{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.example/schema/canonical-database-schema.schema.json",
  "title": "LIGHTYEAR canonical database schema",
  "type": "object",
  "required": ["schema_version", "schema_type", "source_model_sha256", "namespace", "name", "columns", "constraints", "indexes", "stored_logic", "production_ready", "content_sha256"],
  "properties": {
    "schema_type": {"const": "lightyear-canonical-database-schema"},
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "ordinal", "type"],
        "properties": {
          "type": {"type": "object", "required": ["kind", "nullable"]}
        }
      }
    },
    "production_ready": {"const": false},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
