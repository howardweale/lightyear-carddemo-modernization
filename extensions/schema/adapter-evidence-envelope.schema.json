{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schemas/adapter-evidence-envelope-1.0.json",
  "title": "LIGHTYEAR Adapter Evidence Envelope",
  "type": "object",
  "required": [
    "schema_version", "envelope_type", "envelope_id", "adapter", "source",
    "collected_at", "evidence_class", "graph_binding", "scope", "claims",
    "artifacts", "limitations", "content_sha256", "signature"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "envelope_type": {"const": "lightyear-adapter-evidence"},
    "envelope_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "adapter": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}},
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["system", "kind", "attestation"],
      "properties": {
        "system": {"type": "string"}, "kind": {"type": "string"},
        "attestation": {"type": "string"}
      },
      "additionalProperties": false
    },
    "collected_at": {"type": "string", "format": "date-time"},
    "evidence_class": {"enum": ["live", "recorded", "simulated", "inferred"]},
    "graph_binding": {
      "type": "object",
      "required": ["graph_id", "content_sha256"],
      "properties": {
        "graph_id": {"type": "string"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["read_only"],
      "properties": {"read_only": {"const": true}},
      "additionalProperties": true
    },
    "claims": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recorded_from_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["algorithm", "key_id", "value"],
          "properties": {
            "algorithm": {"const": "HMAC-SHA256"},
            "key_id": {"type": "string"},
            "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
