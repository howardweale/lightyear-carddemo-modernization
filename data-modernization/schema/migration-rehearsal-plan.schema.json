{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorydark.ai/schemas/migration-rehearsal-plan-1.0.json",
  "title": "FactoryDark offline migration rehearsal plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_type", "plan_id", "workload", "source", "bindings", "targets", "journal", "recovery_policy", "cutover_policy", "production_ready", "mainframe_equivalent", "limitations", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_type": {"const": "factorydark-offline-migration-rehearsal-plan"},
    "plan_id": {"type": "string", "minLength": 1},
    "workload": {"const": "carddemo-authorization-authfrds"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialect", "table", "evidence_class"],
      "properties": {
        "dialect": {"const": "db2-zos-shaped-fixture"},
        "table": {"const": "CARDDEMO.AUTHFRDS"},
        "evidence_class": {"const": "simulated"}
      }
    },
    "bindings": {"$ref": "#/$defs/bindings"},
    "targets": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
    "journal": {
      "type": "object",
      "required": ["event_count", "first_sequence", "last_sequence", "head_sha256", "events"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 3},
        "first_sequence": {"const": 1},
        "last_sequence": {"type": "integer", "minimum": 3},
        "head_sha256": {"$ref": "#/$defs/hash"},
        "events": {"type": "array", "minItems": 3, "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "recovery_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interrupt_after_sequence", "duplicate_replay_sequence", "maximum_rpo_events", "maximum_rto_steps"],
      "properties": {
        "interrupt_after_sequence": {"type": "integer", "minimum": 1},
        "duplicate_replay_sequence": {"type": "integer", "minimum": 1},
        "maximum_rpo_events": {"type": "integer", "minimum": 0},
        "maximum_rto_steps": {"type": "integer", "minimum": 1}
      }
    },
    "cutover_policy": {"type": "object"},
    "production_ready": {"const": false},
    "mainframe_equivalent": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "content_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_model_sha256", "fixture_catalog_sha256", "postgres_mapping_sha256", "postgres_receipt_sha256", "oracle_mapping_sha256", "oracle_receipt_sha256"],
      "properties": {
        "canonical_model_sha256": {"$ref": "#/$defs/hash"},
        "fixture_catalog_sha256": {"$ref": "#/$defs/hash"},
        "postgres_mapping_sha256": {"$ref": "#/$defs/hash"},
        "postgres_receipt_sha256": {"$ref": "#/$defs/hash"},
        "oracle_mapping_sha256": {"$ref": "#/$defs/hash"},
        "oracle_receipt_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
