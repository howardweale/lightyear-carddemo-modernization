{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightyear.ai/schema/factory/execution-policy-1.0.json",
  "title": "LIGHTYEAR hardened execution policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "runtime", "isolation", "admission", "identities", "secrets"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "image", "image_digest", "allowed_commands", "allowed_environment"],
      "properties": {
        "allowed": {"type": "array", "minItems": 1, "items": {"enum": ["docker", "podman"]}},
        "image": {"type": "string", "minLength": 1},
        "image_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "allowed_commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "allowed_environment": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_mode", "read_only_root", "workspace_read_only", "run_as_user", "cap_drop_all", "no_new_privileges", "pids_limit", "memory_mb", "cpus", "tmpfs_mb"],
      "properties": {
        "network_mode": {"const": "none"},
        "read_only_root": {"const": true},
        "workspace_read_only": {"const": true},
        "run_as_user": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"},
        "cap_drop_all": {"const": true},
        "no_new_privileges": {"const": true},
        "pids_limit": {"type": "integer", "minimum": 16, "maximum": 1024},
        "memory_mb": {"type": "integer", "minimum": 64, "maximum": 32768},
        "cpus": {"type": "number", "minimum": 0.1, "maximum": 16},
        "tmpfs_mb": {"type": "integer", "minimum": 8, "maximum": 1024}
      }
    },
    "admission": {"type": "object"},
    "identities": {"type": "object"},
    "secrets": {"type": "object"}
  }
}
